# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle
.gradle/
build/

# Local configuration (SDK path, etc.)
local.properties

# Android Studio / IntelliJ
*.iml
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Keystore files and signing secrets (do not commit)
*.jks
*.keystore
keystore.properties

# Release output from scripts/publish-release.ps1 (APK, SHA-256, notes). Kept
# out of git so a rerun after a failed or draft publish sees a clean tree.
dist/

# Logs
*.log

# Crash artifacts
*.stackdump

# Jazzer fuzzing scratch: the working corpus, and raw findings dropped in the
# module directory when Jazzer cannot find the seed corpus. Anchored to app/ on
# purpose: a reproducer Jazzer writes next to the seed corpus
# (app/src/test/resources/**/*FuzzTestInputs/<method>/crash-<hash>) must stay
# visible to git, because committing it there is how a finding becomes a
# permanent regression test.
/app/.cifuzz-corpus/
/app/crash-*
/app/timeout-*
/app/slow-unit-*
/app/oom-*
